{
  "openapi": "3.0.0",
  "info": {
    "title": "Collector telemetry",
    "version": "1.0",
    "description": "Aggregated multi-region telemetry that the Collector service pushes to frontend clients via websocket. This is not a REST API; the data is delivered over a websocket connection."
  },
  "servers": [
    {
      "url": "Websocket"
    }
  ],
  "paths": {
    "/RegionsTelemetry": {
      "post": {
        "summary": "RegionsTelemetry",
        "tags": [],
        "responses": {},
        "operationId": "post-RegionsTelemetry",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../../Models/Collector/RegionsTelemetryOut.json"
              },
              "example": {
                "regionsTele": [
                  {
                    "regionHost": "grok-test-region1.qcc-mvp.grok-digital.com",
                    "regionName": "grok-test-region1.qcc-mvp.grok-digital.com",
                    "AirVehicleTelemetry": [
                      {
                        "id": "localhost:7705",
                        "ip": "localhost:7705",
                        "name": "M4T-01",
                        "type": "dji",
                        "missionId": "MSN-2026-06-01-001",
                        "energy": 78.4,
                        "energyConsumption": 0.3,
                        "location": {
                          "geometry": {
                            "type": "Point",
                            "coordinates": [34.781768, 32.0853, 42.6]
                          }
                        },
                        "heading": 182.4,
                        "status": "On Mission",
                        "height": 42.6,
                        "velocity": 12.3,
                        "zoomValue": 3,
                        "controlledBy": "Onboard",
                        "headingMode": "fixed",
                        "voltage": 22.1,
                        "lockedForRH": false,
                        "onRhRequest": false,
                        "gimbal": { "roll": 0.2, "pitch": -32.5, "yaw": 181.8 },
                        "timestamp": 1771503605668,
                        "videoUrls": [
                          {
                            "videoUrl": "rtsp://grok-test-region1.qcc-mvp.grok-digital.com:8554/live/M4T-01",
                            "type": "rtsp"
                          }
                        ],
                        "timestampLastChanged": 1771503605668
                      }
                    ],
                    "GimbalsTelemetry": [
                      {
                        "sensorId": "gimbal-01",
                        "gimbalType": "DJI",
                        "isLookAtTarget": true,
                        "yaw": 270,
                        "pitch": -5,
                        "roll": 10,
                        "timestampLastChanged": 1771503605668
                      }
                    ],
                    "MissionsTelemetry": [
                      {
                        "missionId": "MSN-2026-06-01-001",
                        "type": "Route",
                        "status": "Started",
                        "timestampLastChanged": 1771503605668
                      }
                    ],
                    "UserMessages": [
                      {
                        "id": "msg-1001",
                        "type": "info",
                        "title": "Mission started",
                        "message": "Highway Patrol A is now running",
                        "timestamp": 1771503605668,
                        "airVehicleId": "localhost:7705",
                        "missionId": "MSN-2026-06-01-001",
                        "timestampLastChanged": 1771503605668
                      }
                    ]
                  }
                ]
              }
            }
          }
        },
        "description": "***THIS IS NOT A REST REQUEST, BUT WEBSOCKET***\n\nAggregated telemetry that the Collector sends to frontend clients via websocket.\n\n- The Collector connects to every region in its configuration (regions.json), authenticates against each region's MAPI and subscribes to four rooms per region: AirVehicleTelemetry, GimbalsTelemetry, MissionsTelemetry, UserMessages.\n- This message is emitted once per second (telemetryBroadcastInterval, configurable, default 1000 ms).\n- A region is omitted entirely from `regionsTele` when the newest telemetry received from it is older than a configurable staleness window of X seconds (telemetryStalenessThreshold).\n- Each room is an array of the raw telemetry items exactly as MAPI sent them, with `timestampLastChanged` (epoch-ms of that item's last change) merged onto each item. AirVehicleTelemetry items additionally carry `videoUrls`."
      },
      "parameters": []
    }
  },
  "components": {
    "schemas": {}
  }
}
